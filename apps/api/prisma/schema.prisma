generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

enum PrivacyVisibility {
  PUBLIC
  PRIVATE
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum SharedWatchlistVisibility {
  MEMBERS
  PRIVATE
}

enum SharedVotingStatus {
  OPEN
  CLOSED
}

enum TrackedContentType {
  MOVIE
  SERIES
}

enum UserContentStatus {
  WATCHLISTED
  WATCHING
  WATCHED
  DROPPED
}

enum ViewingContentType {
  MOVIE
  EPISODE
}

enum ReportTargetType {
  PROFILE
  MOVIE_REVIEW
  EPISODE_REVIEW
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  IMPERSONATION
  INTELLECTUAL_PROPERTY
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReleaseNotificationType {
  MOVIE_RELEASE
  SEASON_RELEASE
  EPISODE_RELEASE
}

enum NotificationKind {
  RELEASE
  SHARED_LIST_INVITE
  SHARED_VOTE_UPDATE
}

enum AuditAction {
  PRIVACY_UPDATED
  USER_BLOCKED
  USER_UNBLOCKED
}

enum DataImportSource {
  LETTERBOXD
  IMDB
}

enum DataImportStatus {
  PREVIEWED
  COMPLETED
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  avatarObjectKey            String?
  profileBackdropContentType TrackedContentType?
  profileBackdropTmdbId      Int?
  displayName                String?
  handle                     String?                    @unique @db.VarChar(20)
  onboardingCompleted        Boolean                    @default(false)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  authIdentities             AuthIdentity[]
  contentStates              UserContentState[]
  dataImports                DataImport[]
  episodeProgress            UserEpisodeProgress[]
  episodeRatings             UserEpisodeRating[]
  episodeReviewLikes         EpisodeReviewLike[]
  episodeReviews             UserEpisodeReview[]
  movieRatings               UserMovieRating[]
  movieReviewLikes           MovieReviewLike[]
  movieReviews               UserMovieReview[]
  reportsReceived            ContentReport[]            @relation("ReportedUser")
  reportsSubmitted           ContentReport[]            @relation("ReportReporter")
  releaseAlertSubscriptions  ReleaseAlertSubscription[]
  notifications              Notification[]             @relation("NotificationRecipient")
  actedNotifications         Notification[]             @relation("NotificationActor")
  privacySettings            PrivacySettings?
  blockedUsers               UserBlock[]                @relation("UserBlocksMade")
  blockedBy                  UserBlock[]                @relation("UserBlocksReceived")
  following                  UserFollow[]               @relation("UserFollowsMade")
  followers                  UserFollow[]               @relation("UserFollowsReceived")
  personalWatchlists         PersonalWatchlist[]
  ownedSharedWatchlists      SharedWatchlist[]          @relation("SharedWatchlistOwner")
  sharedWatchlistMemberships SharedWatchlistMember[]
  sharedVotingVotes          SharedVotingVote[]
  viewingEvents              ViewingEvent[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model PrivacySettings {
  userId                    String                    @id @db.Uuid
  profileVisibility         PrivacyVisibility         @default(PRIVATE)
  viewingHistoryVisibility  PrivacyVisibility         @default(PRIVATE)
  episodeProgressVisibility PrivacyVisibility         @default(PRIVATE)
  reviewsVisibility         PrivacyVisibility         @default(PRIVATE)
  ratingsVisibility         PrivacyVisibility         @default(PRIVATE)
  sharedWatchlistVisibility SharedWatchlistVisibility @default(MEMBERS)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model UserContentState {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  contentType TrackedContentType
  tmdbId      Int
  status      UserContentStatus?
  favorite    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, tmdbId])
  @@index([userId])
  @@index([contentType, tmdbId])
  @@map("user_content_states")
}

model UserMovieRating {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tmdbId         Int
  scoreHalfSteps Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
  @@index([tmdbId])
  @@map("user_movie_ratings")
}

model UserEpisodeRating {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  seriesTmdbId   Int
  seasonNumber   Int
  episodeNumber  Int
  scoreHalfSteps Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesTmdbId, seasonNumber, episodeNumber])
  @@index([userId])
  @@index([seriesTmdbId, seasonNumber])
  @@map("user_episode_ratings")
}

model UserMovieReview {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  tmdbId    Int
  body      String            @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  likes     MovieReviewLike[]
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
  @@index([tmdbId])
  @@map("user_movie_reviews")
}

model MovieReviewLike {
  id        String          @id @default(uuid()) @db.Uuid
  reviewId  String          @db.Uuid
  userId    String          @db.Uuid
  createdAt DateTime        @default(now())
  review    UserMovieReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("movie_review_likes")
}

model UserEpisodeReview {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  seriesTmdbId  Int
  seasonNumber  Int
  episodeNumber Int
  body          String              @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  likes         EpisodeReviewLike[]
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesTmdbId, seasonNumber, episodeNumber])
  @@index([userId])
  @@index([seriesTmdbId, seasonNumber])
  @@map("user_episode_reviews")
}

model EpisodeReviewLike {
  id        String            @id @default(uuid()) @db.Uuid
  reviewId  String            @db.Uuid
  userId    String            @db.Uuid
  createdAt DateTime          @default(now())
  review    UserEpisodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("episode_review_likes")
}

model UserEpisodeProgress {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  seriesTmdbId  Int
  seasonNumber  Int
  episodeNumber Int
  watchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesTmdbId, seasonNumber, episodeNumber])
  @@index([userId])
  @@index([seriesTmdbId, seasonNumber])
  @@map("user_episode_progress")
}

model ViewingEvent {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  contentType    ViewingContentType
  tmdbId         Int
  seasonNumber   Int?
  episodeNumber  Int?
  title          String?
  subtitle       String?
  artworkUrl     String?
  genres         String[]           @default([])
  runtimeMinutes Int?
  watchedAt      DateTime?
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([userId, contentType, tmdbId])
  @@index([userId, contentType, tmdbId, seasonNumber, episodeNumber])
  @@map("viewing_events")
}

model DataImport {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  source      DataImportSource
  status      DataImportStatus @default(PREVIEWED)
  fileName    String           @db.VarChar(255)
  preview     Json
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("data_imports")
}

model ContentReport {
  id               String           @id @default(uuid()) @db.Uuid
  reporterId       String           @db.Uuid
  reportedUserId   String           @db.Uuid
  targetType       ReportTargetType
  targetId         String           @db.Uuid
  reason           ReportReason
  details          String?          @db.VarChar(500)
  status           ReportStatus     @default(PENDING)
  targetSnapshot   Json
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  resolvedAt       DateTime?
  reporter         User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser     User             @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([reportedUserId])
  @@index([status, createdAt])
  @@map("content_reports")
}

model UserBlock {
  id            String   @id @default(uuid()) @db.Uuid
  blockerId     String   @db.Uuid
  blockedUserId String   @db.Uuid
  createdAt     DateTime @default(now())
  blockedUser   User     @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blocker       User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

model UserFollow {
  id             String       @id @default(uuid()) @db.Uuid
  followerId     String       @db.Uuid
  followedUserId String       @db.Uuid
  status         FollowStatus @default(ACCEPTED)
  createdAt      DateTime     @default(now())
  followedUser   User         @relation("UserFollowsReceived", fields: [followedUserId], references: [id], onDelete: Cascade)
  follower       User         @relation("UserFollowsMade", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedUserId])
  @@index([followedUserId])
  @@index([followedUserId, status])
  @@map("user_follows")
}

model PersonalWatchlist {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  name       String                  @db.VarChar(80)
  visibility PrivacyVisibility       @default(PRIVATE)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  items      PersonalWatchlistItem[]
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_watchlists")
}

model PersonalWatchlistItem {
  id          String             @id @default(uuid()) @db.Uuid
  watchlistId String             @db.Uuid
  contentType TrackedContentType
  tmdbId      Int
  createdAt   DateTime           @default(now())
  watchlist   PersonalWatchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, contentType, tmdbId])
  @@index([contentType, tmdbId])
  @@map("personal_watchlist_items")
}

model SharedWatchlist {
  id             String                  @id @default(uuid()) @db.Uuid
  ownerId        String                  @db.Uuid
  name           String                  @db.VarChar(80)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          SharedWatchlistItem[]
  members        SharedWatchlistMember[]
  owner          User                    @relation("SharedWatchlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  votingSessions SharedVotingSession[]
  notifications  Notification[]

  @@index([ownerId])
  @@map("shared_watchlists")
}

model SharedWatchlistMember {
  id          String          @id @default(uuid()) @db.Uuid
  watchlistId String          @db.Uuid
  userId      String          @db.Uuid
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist   SharedWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, userId])
  @@index([userId])
  @@map("shared_watchlist_members")
}

model SharedWatchlistItem {
  id          String                  @id @default(uuid()) @db.Uuid
  watchlistId String                  @db.Uuid
  contentType TrackedContentType
  tmdbId      Int
  createdAt   DateTime                @default(now())
  candidates  SharedVotingCandidate[]
  watchlist   SharedWatchlist         @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, contentType, tmdbId])
  @@index([contentType, tmdbId])
  @@map("shared_watchlist_items")
}

model SharedVotingSession {
  id                 String                  @id @default(uuid()) @db.Uuid
  watchlistId        String                  @db.Uuid
  title              String                  @db.VarChar(80)
  status             SharedVotingStatus      @default(OPEN)
  closesAt           DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '7 days')"))
  closedAt           DateTime?
  winningCandidateId String?                 @db.Uuid
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  candidates         SharedVotingCandidate[] @relation("SharedVotingCandidates")
  winner             SharedVotingCandidate?  @relation("SharedVotingWinner", fields: [winningCandidateId], references: [id], onDelete: SetNull)
  watchlist          SharedWatchlist         @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  notifications      Notification[]

  @@index([watchlistId])
  @@index([status, closesAt])
  @@index([winningCandidateId])
  @@map("shared_voting_sessions")
}

model SharedVotingCandidate {
  id          String                @id @default(uuid()) @db.Uuid
  sessionId   String                @db.Uuid
  itemId      String                @db.Uuid
  createdAt   DateTime              @default(now())
  item        SharedWatchlistItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  session     SharedVotingSession   @relation("SharedVotingCandidates", fields: [sessionId], references: [id], onDelete: Cascade)
  wonSessions SharedVotingSession[] @relation("SharedVotingWinner")
  votes       SharedVotingVote[]

  @@unique([sessionId, itemId])
  @@index([itemId])
  @@map("shared_voting_candidates")
}

model SharedVotingVote {
  id          String                @id @default(uuid()) @db.Uuid
  candidateId String                @db.Uuid
  userId      String                @db.Uuid
  createdAt   DateTime              @default(now())
  candidate   SharedVotingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([candidateId, userId])
  @@index([userId])
  @@map("shared_voting_votes")
}

model Notification {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @db.Uuid
  kind              NotificationKind         @default(RELEASE)
  releaseType       ReleaseNotificationType?
  contentType       TrackedContentType?
  tmdbId            Int?
  seasonNumber      Int?
  episodeNumber     Int?
  title             String                   @db.VarChar(160)
  body              String                   @db.VarChar(500)
  releasedAt        DateTime?
  readAt            DateTime?
  dedupeKey         String                   @db.VarChar(160)
  sharedWatchlistId String?                  @db.Uuid
  votingSessionId   String?                  @db.Uuid
  actorUserId       String?                  @db.Uuid
  routeMetadata     Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor             User?                    @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  sharedWatchlist   SharedWatchlist?         @relation(fields: [sharedWatchlistId], references: [id], onDelete: Cascade)
  votingSession     SharedVotingSession?     @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([contentType, tmdbId])
  @@index([sharedWatchlistId])
  @@index([votingSessionId])
  @@index([actorUserId])
  @@map("notifications")
}

model ReleaseAlertSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  contentType TrackedContentType
  tmdbId      Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, tmdbId])
  @@index([contentType, tmdbId])
  @@map("release_alert_subscriptions")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  actorUserId  String      @db.Uuid
  action       AuditAction
  targetUserId String?     @db.Uuid
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model CatalogueSpotlight {
  id           String   @id @db.VarChar(32)
  tmdbId       Int
  title        String
  overview     String
  posterUrl    String?
  backdropUrl  String
  releaseDate  String?  @db.VarChar(10)
  voteAverage  Float?
  selectedAt   DateTime
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@map("catalogue_spotlights")
}
