generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

enum PrivacyVisibility {
  PUBLIC
  PRIVATE
}

enum SharedWatchlistVisibility {
  MEMBERS
  PRIVATE
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  displayName     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  authIdentities  AuthIdentity[]
  privacySettings PrivacySettings?

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model PrivacySettings {
  userId                    String                    @id @db.Uuid
  profileVisibility         PrivacyVisibility         @default(PUBLIC)
  viewingHistoryVisibility  PrivacyVisibility         @default(PRIVATE)
  episodeProgressVisibility PrivacyVisibility         @default(PRIVATE)
  reviewsVisibility         PrivacyVisibility         @default(PUBLIC)
  ratingsVisibility         PrivacyVisibility         @default(PRIVATE)
  sharedWatchlistVisibility SharedWatchlistVisibility @default(MEMBERS)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}
