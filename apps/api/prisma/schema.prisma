generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
  FACEBOOK
  DISCORD
}

enum PrivacyVisibility {
  PUBLIC
  PRIVATE
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum SharedWatchlistVisibility {
  MEMBERS
  PRIVATE
}

enum SharedVotingStatus {
  OPEN
  CLOSED
}

enum TrackedContentType {
  MOVIE
  SERIES
}

enum UserContentStatus {
  WATCHLISTED
  WATCHING
  WATCHED
  DROPPED
}

enum ViewingContentType {
  MOVIE
  EPISODE
}

enum ReportTargetType {
  PROFILE
  MOVIE_REVIEW
  EPISODE_REVIEW
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  IMPERSONATION
  INTELLECTUAL_PROPERTY
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReleaseNotificationType {
  MOVIE_RELEASE
  SEASON_RELEASE
  EPISODE_RELEASE
}

enum NotificationKind {
  RELEASE
  SHARED_LIST_INVITE
  SHARED_VOTE_UPDATE
}

enum ReleaseDatePrecision {
  DATE
  UNKNOWN
}

enum ReleaseEventStatus {
  ACTIVE
  WITHDRAWN
}

enum ReleaseEventSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum PushPlatform {
  IOS
  ANDROID
}

enum PushDeliveryStatus {
  PENDING
  TICKETED
  DELIVERED
  FAILED
}

enum AuditAction {
  PRIVACY_UPDATED
  USER_BLOCKED
  USER_UNBLOCKED
}

enum AdminAuditAction {
  REPORT_LIST_VIEWED
  REPORT_VIEWED
  REPORT_STATUS_CHANGED
  USER_LIST_VIEWED
  USER_VIEWED
  USER_SUSPENDED
  USER_REACTIVATED
  CONTENT_HIDDEN
  CONTENT_RESTORED
}

enum DataImportSource {
  LETTERBOXD
  IMDB
  TV_TIME
}

enum DataImportStatus {
  PREVIEWED
  COMPLETED
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  firebaseUid                String                     @unique @db.VarChar(128)
  avatarObjectKey            String?
  profileBackdropContentType TrackedContentType?
  profileBackdropTmdbId      Int?
  displayName                String?
  handle                     String?                    @unique @db.VarChar(20)
  onboardingCompleted        Boolean                    @default(false)
  suspendedAt                DateTime?
  suspendedUntil             DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  authIdentities             AuthIdentity[]
  contentStates              UserContentState[]
  dataImports                DataImport[]
  episodeProgress            UserEpisodeProgress[]
  episodeRatings             UserEpisodeRating[]
  episodeReviewLikes         EpisodeReviewLike[]
  episodeReviews             UserEpisodeReview[]
  movieRatings               UserMovieRating[]
  movieReviewLikes           MovieReviewLike[]
  movieReviews               UserMovieReview[]
  reportsReceived            ContentReport[]            @relation("ReportedUser")
  reportsSubmitted           ContentReport[]            @relation("ReportReporter")
  suspensions                UserSuspension[]
  releaseAlertSubscriptions  ReleaseAlertSubscription[]
  notifications              Notification[]             @relation("NotificationRecipient")
  actedNotifications         Notification[]             @relation("NotificationActor")
  notificationPreference     NotificationPreference?
  pushDevices                PushDevice[]
  privacySettings            PrivacySettings?
  blockedUsers               UserBlock[]                @relation("UserBlocksMade")
  blockedBy                  UserBlock[]                @relation("UserBlocksReceived")
  following                  UserFollow[]               @relation("UserFollowsMade")
  followers                  UserFollow[]               @relation("UserFollowsReceived")
  personalWatchlists         PersonalWatchlist[]
  ownedSharedWatchlists      SharedWatchlist[]          @relation("SharedWatchlistOwner")
  sharedWatchlistMemberships SharedWatchlistMember[]
  sharedVotingVotes          SharedVotingVote[]
  viewingEvents              ViewingEvent[]

  @@map("users")
}

model OAuthAttempt {
  id                     String       @id @default(uuid()) @db.Uuid
  provider               AuthProvider
  stateHash              String       @unique @db.VarChar(64)
  completionHash         String?      @unique @db.VarChar(64)
  appRedirectUri         String       @db.VarChar(512)
  initiatedByFirebaseUid String?      @db.VarChar(128)
  providerUserId         String?
  email                  String?      @db.VarChar(320)
  emailVerified          Boolean?
  displayName            String?
  photoUrl               String?
  expiresAt              DateTime
  completedAt            DateTime?
  consumedAt             DateTime?
  createdAt              DateTime     @default(now())

  @@index([expiresAt])
  @@map("oauth_attempts")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerUserId  String
  email           String?      @db.VarChar(320)
  emailNormalized String?      @db.VarChar(320)
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([emailNormalized])
  @@index([userId])
  @@map("auth_identities")
}

model PrivacySettings {
  userId                    String                    @id @db.Uuid
  profileVisibility         PrivacyVisibility         @default(PUBLIC)
  viewingHistoryVisibility  PrivacyVisibility         @default(PUBLIC)
  episodeProgressVisibility PrivacyVisibility         @default(PUBLIC)
  reviewsVisibility         PrivacyVisibility         @default(PUBLIC)
  ratingsVisibility         PrivacyVisibility         @default(PUBLIC)
  sharedWatchlistVisibility SharedWatchlistVisibility @default(MEMBERS)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model UserContentState {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  contentType TrackedContentType
  tmdbId      Int
  status      UserContentStatus?
  favorite    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, tmdbId])
  @@index([userId])
  @@index([contentType, tmdbId])
  @@map("user_content_states")
}

model UserMovieRating {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tmdbId         Int
  scoreHalfSteps Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
  @@index([tmdbId])
  @@map("user_movie_ratings")
}

model UserEpisodeRating {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  seriesTmdbId   Int
  seasonNumber   Int
  episodeNumber  Int
  scoreHalfSteps Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesTmdbId, seasonNumber, episodeNumber])
  @@index([userId])
  @@index([seriesTmdbId, seasonNumber])
  @@map("user_episode_ratings")
}

model UserMovieReview {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @db.Uuid
  tmdbId             Int
  body               String            @db.Text
  moderationHiddenAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  likes              MovieReviewLike[]
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
  @@index([tmdbId])
  @@map("user_movie_reviews")
}

model MovieReviewLike {
  id        String          @id @default(uuid()) @db.Uuid
  reviewId  String          @db.Uuid
  userId    String          @db.Uuid
  createdAt DateTime        @default(now())
  review    UserMovieReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("movie_review_likes")
}

model UserEpisodeReview {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  seriesTmdbId       Int
  seasonNumber       Int
  episodeNumber      Int
  body               String              @db.Text
  moderationHiddenAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  likes              EpisodeReviewLike[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesTmdbId, seasonNumber, episodeNumber])
  @@index([userId])
  @@index([seriesTmdbId, seasonNumber])
  @@map("user_episode_reviews")
}

model EpisodeReviewLike {
  id        String            @id @default(uuid()) @db.Uuid
  reviewId  String            @db.Uuid
  userId    String            @db.Uuid
  createdAt DateTime          @default(now())
  review    UserEpisodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("episode_review_likes")
}

model UserEpisodeProgress {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  seriesTmdbId  Int
  seasonNumber  Int
  episodeNumber Int
  watchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesTmdbId, seasonNumber, episodeNumber])
  @@index([userId])
  @@index([seriesTmdbId, seasonNumber])
  @@map("user_episode_progress")
}

model ViewingEvent {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  contentType    ViewingContentType
  tmdbId         Int
  seasonNumber   Int?
  episodeNumber  Int?
  title          String?
  subtitle       String?
  artworkUrl     String?
  genres         String[]           @default([])
  runtimeMinutes Int?
  watchedAt      DateTime?
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([userId, contentType, tmdbId])
  @@index([userId, contentType, tmdbId, seasonNumber, episodeNumber])
  @@map("viewing_events")
}

model DataImport {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  source      DataImportSource
  status      DataImportStatus @default(PREVIEWED)
  fileName    String           @db.VarChar(255)
  preview     Json
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("data_imports")
}

model ContentReport {
  id               String           @id @default(uuid()) @db.Uuid
  reporterId       String           @db.Uuid
  reportedUserId   String           @db.Uuid
  targetType       ReportTargetType
  targetId         String           @db.Uuid
  reason           ReportReason
  details          String?          @db.VarChar(500)
  status           ReportStatus     @default(PENDING)
  targetSnapshot   Json
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  resolvedAt       DateTime?
  reporter         User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser     User             @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  suspensions      UserSuspension[]

  @@unique([reporterId, targetType, targetId])
  @@index([reportedUserId])
  @@index([status, createdAt])
  @@map("content_reports")
}

model UserSuspension {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @db.Uuid
  reportId              String?        @db.Uuid
  startsAt              DateTime       @default(now())
  endsAt                DateTime?
  liftedAt              DateTime?
  note                  String         @db.Text
  createdByFirebaseUid  String         @db.VarChar(128)
  createdByEmail        String         @db.VarChar(320)
  liftedNote            String?        @db.Text
  liftedByFirebaseUid   String?        @db.VarChar(128)
  liftedByEmail         String?        @db.VarChar(320)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  report                ContentReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([reportId])
  @@map("user_suspensions")
}

model UserBlock {
  id            String   @id @default(uuid()) @db.Uuid
  blockerId     String   @db.Uuid
  blockedUserId String   @db.Uuid
  createdAt     DateTime @default(now())
  blockedUser   User     @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blocker       User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

model UserFollow {
  id             String       @id @default(uuid()) @db.Uuid
  followerId     String       @db.Uuid
  followedUserId String       @db.Uuid
  status         FollowStatus @default(ACCEPTED)
  createdAt      DateTime     @default(now())
  followedUser   User         @relation("UserFollowsReceived", fields: [followedUserId], references: [id], onDelete: Cascade)
  follower       User         @relation("UserFollowsMade", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedUserId])
  @@index([followedUserId])
  @@index([followedUserId, status])
  @@map("user_follows")
}

model PersonalWatchlist {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  name       String                  @db.VarChar(80)
  visibility PrivacyVisibility       @default(PRIVATE)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  items      PersonalWatchlistItem[]
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_watchlists")
}

model PersonalWatchlistItem {
  id          String             @id @default(uuid()) @db.Uuid
  watchlistId String             @db.Uuid
  contentType TrackedContentType
  tmdbId      Int
  createdAt   DateTime           @default(now())
  watchlist   PersonalWatchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, contentType, tmdbId])
  @@index([contentType, tmdbId])
  @@map("personal_watchlist_items")
}

model SharedWatchlist {
  id             String                  @id @default(uuid()) @db.Uuid
  ownerId        String                  @db.Uuid
  name           String                  @db.VarChar(80)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          SharedWatchlistItem[]
  members        SharedWatchlistMember[]
  owner          User                    @relation("SharedWatchlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  votingSessions SharedVotingSession[]
  notifications  Notification[]

  @@index([ownerId])
  @@map("shared_watchlists")
}

model SharedWatchlistMember {
  id          String          @id @default(uuid()) @db.Uuid
  watchlistId String          @db.Uuid
  userId      String          @db.Uuid
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist   SharedWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, userId])
  @@index([userId])
  @@map("shared_watchlist_members")
}

model SharedWatchlistItem {
  id          String                  @id @default(uuid()) @db.Uuid
  watchlistId String                  @db.Uuid
  contentType TrackedContentType
  tmdbId      Int
  createdAt   DateTime                @default(now())
  candidates  SharedVotingCandidate[]
  watchlist   SharedWatchlist         @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, contentType, tmdbId])
  @@index([contentType, tmdbId])
  @@map("shared_watchlist_items")
}

model SharedVotingSession {
  id                 String                  @id @default(uuid()) @db.Uuid
  watchlistId        String                  @db.Uuid
  title              String                  @db.VarChar(80)
  status             SharedVotingStatus      @default(OPEN)
  closesAt           DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '7 days')"))
  closedAt           DateTime?
  winningCandidateId String?                 @db.Uuid
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  candidates         SharedVotingCandidate[] @relation("SharedVotingCandidates")
  winner             SharedVotingCandidate?  @relation("SharedVotingWinner", fields: [winningCandidateId], references: [id], onDelete: SetNull)
  watchlist          SharedWatchlist         @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  notifications      Notification[]

  @@index([watchlistId])
  @@index([status, closesAt])
  @@index([winningCandidateId])
  @@map("shared_voting_sessions")
}

model SharedVotingCandidate {
  id          String                @id @default(uuid()) @db.Uuid
  sessionId   String                @db.Uuid
  itemId      String                @db.Uuid
  createdAt   DateTime              @default(now())
  item        SharedWatchlistItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  session     SharedVotingSession   @relation("SharedVotingCandidates", fields: [sessionId], references: [id], onDelete: Cascade)
  wonSessions SharedVotingSession[] @relation("SharedVotingWinner")
  votes       SharedVotingVote[]

  @@unique([sessionId, itemId])
  @@index([itemId])
  @@map("shared_voting_candidates")
}

model SharedVotingVote {
  id          String                @id @default(uuid()) @db.Uuid
  candidateId String                @db.Uuid
  userId      String                @db.Uuid
  createdAt   DateTime              @default(now())
  candidate   SharedVotingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([candidateId, userId])
  @@index([userId])
  @@map("shared_voting_votes")
}

model Notification {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @db.Uuid
  kind              NotificationKind         @default(RELEASE)
  releaseType       ReleaseNotificationType?
  contentType       TrackedContentType?
  tmdbId            Int?
  seasonNumber      Int?
  episodeNumber     Int?
  title             String                   @db.VarChar(160)
  body              String                   @db.VarChar(500)
  releasedAt        DateTime?
  readAt            DateTime?
  dedupeKey         String                   @db.VarChar(160)
  sharedWatchlistId String?                  @db.Uuid
  votingSessionId   String?                  @db.Uuid
  actorUserId       String?                  @db.Uuid
  routeMetadata     Json?
  releaseEventId    String?                  @db.Uuid
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor             User?                    @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  sharedWatchlist   SharedWatchlist?         @relation(fields: [sharedWatchlistId], references: [id], onDelete: Cascade)
  votingSession     SharedVotingSession?     @relation(fields: [votingSessionId], references: [id], onDelete: Cascade)
  releaseEvent      ReleaseEvent?            @relation(fields: [releaseEventId], references: [id], onDelete: SetNull)
  pushDeliveries    PushDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([contentType, tmdbId])
  @@index([sharedWatchlistId])
  @@index([votingSessionId])
  @@index([actorUserId])
  @@index([releaseEventId])
  @@map("notifications")
}

model ReleaseEvent {
  id            String                  @id @default(uuid()) @db.Uuid
  source        String                  @default("TMDB") @db.VarChar(32)
  sourceKey     String                  @unique @db.VarChar(160)
  type          ReleaseNotificationType
  contentType   TrackedContentType
  tmdbId        Int
  seasonNumber  Int?
  episodeNumber Int?
  title         String                  @db.VarChar(160)
  releaseDate   DateTime?               @db.Date
  precision     ReleaseDatePrecision    @default(UNKNOWN)
  timeZone      String?                 @db.VarChar(64)
  regionCode    String?                 @db.Char(2)
  status        ReleaseEventStatus      @default(ACTIVE)
  lastSyncedAt  DateTime
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  notifications Notification[]

  @@index([contentType, tmdbId, status, releaseDate])
  @@index([status, releaseDate])
  @@map("release_events")
}

model ReleaseEventSyncRun {
  id             String                 @id @default(uuid()) @db.Uuid
  status         ReleaseEventSyncStatus @default(RUNNING)
  contentCount   Int                    @default(0)
  createdCount   Int                    @default(0)
  updatedCount   Int                    @default(0)
  withdrawnCount Int                    @default(0)
  failedCount    Int                    @default(0)
  errorSummary   String?                @db.VarChar(1000)
  startedAt      DateTime               @default(now())
  completedAt    DateTime?

  @@index([startedAt])
  @@index([status, startedAt])
  @@map("release_event_sync_runs")
}

model ReleaseAlertSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  contentType TrackedContentType
  tmdbId      Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, tmdbId])
  @@index([contentType, tmdbId])
  @@map("release_alert_subscriptions")
}

model NotificationPreference {
  userId             String   @id @db.Uuid
  pushEnabled        Boolean  @default(false)
  releasePushEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushDevice {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  environment      String         @db.VarChar(16)
  platform         PushPlatform
  expoPushToken    String         @db.VarChar(255)
  active           Boolean        @default(true)
  lastRegisteredAt DateTime       @default(now())
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries       PushDelivery[]

  @@unique([environment, expoPushToken])
  @@index([userId, environment, active])
  @@map("push_devices")
}

model PushDelivery {
  id               String             @id @default(uuid()) @db.Uuid
  notificationId   String             @db.Uuid
  pushDeviceId     String             @db.Uuid
  status           PushDeliveryStatus @default(PENDING)
  ticketId         String?            @unique @db.VarChar(64)
  attemptCount     Int                @default(0)
  nextAttemptAt    DateTime           @default(now())
  lastAttemptAt    DateTime?
  errorCode        String?            @db.VarChar(64)
  errorMessage     String?            @db.VarChar(500)
  sentAt           DateTime?
  receiptCheckedAt DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  notification     Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushDevice       PushDevice         @relation(fields: [pushDeviceId], references: [id], onDelete: Cascade)

  @@unique([notificationId, pushDeviceId])
  @@index([status, nextAttemptAt])
  @@map("push_deliveries")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  actorUserId  String      @db.Uuid
  action       AuditAction
  targetUserId String?     @db.Uuid
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AdminAuditLog {
  id               String           @id @default(uuid()) @db.Uuid
  actorFirebaseUid String           @db.VarChar(128)
  actorEmail       String           @db.VarChar(320)
  action           AdminAuditAction
  reportId         String?          @db.Uuid
  reportedUserId   String?          @db.Uuid
  metadata         Json?
  createdAt        DateTime         @default(now())

  @@index([actorFirebaseUid, createdAt])
  @@index([action, createdAt])
  @@index([reportId, createdAt])
  @@map("admin_audit_logs")
}

model CatalogueSpotlight {
  id           String   @id @db.VarChar(32)
  tmdbId       Int
  title        String
  overview     String
  posterUrl    String?
  backdropUrl  String
  releaseDate  String?  @db.VarChar(10)
  voteAverage  Float?
  selectedAt   DateTime
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@map("catalogue_spotlights")
}
