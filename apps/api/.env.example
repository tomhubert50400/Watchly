NODE_ENV=development
APP_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8081
CORS_ADDITIONAL_ORIGIN=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tv_app?schema=public
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
# Required in staging and production. Use the API application's Better Stack DSN.
ERROR_TRACKING_DSN=
# Required only in staging. Generate at least 32 random characters and keep it sealed.
MONITORING_TEST_KEY=
# Optional for local Firebase Auth emulator usage, for example 127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=

# Backend OAuth bridge for Discord and Facebook. The callback base must be public HTTPS.
AUTH_APP_REDIRECT_URI=com.tom.tvapp.dev://auth/oauth
AUTH_OAUTH_CALLBACK_BASE_URL=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
FACEBOOK_GRAPH_API_VERSION=v24.0
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Backend-only TMDB API Read Access Token.
TMDB_ACCESS_TOKEN=
# Optional Expo Push Service access token when enhanced push security is enabled.
EXPO_PUSH_ACCESS_TOKEN=

# Optional Cloudflare R2 avatar storage. Leave all values empty to keep uploads disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Use the bucket's r2.dev URL during development, without a trailing slash.
R2_PUBLIC_BASE_URL=
