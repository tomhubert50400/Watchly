{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:verify": "tsx src/database/verify-database.ts",
    "dev:prepare-ui-review": "tsx src/dev/prepare-ui-review-data.ts",
    "prisma:generate": "prisma generate",
    "security:audit-smoke": "tsx src/security/audit-log-smoke.ts",
    "security:backup-readiness": "tsx src/security/backup-readiness.ts",
    "security:deployment-smoke": "tsx src/security/deployment-smoke.ts",
    "security:env-secrets": "tsx src/security/environment-secrets-check.ts",
    "security:privacy-smoke": "tsx src/security/privacy-smoke.ts",
    "security:shared-watchlist-smoke": "tsx src/security/shared-watchlist-smoke.ts",
    "security:shared-vote-migration-smoke": "tsx src/security/shared-vote-migration-smoke.ts",
    "security:onboarding-smoke": "tsx src/security/onboarding-smoke.ts",
    "security:notifications-smoke": "tsx src/security/notifications-smoke.ts",
    "security:prisma-reset-smoke": "tsx src/security/prisma-connection-reset-smoke.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "tsx src/security/security-qa.ts && tsx src/security/auth-token-verifier-qa.ts && tsx src/security/external-http-qa.ts && tsx src/security/notifications-sync-qa.ts",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.2.0",
    "joi": "^18.2.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
