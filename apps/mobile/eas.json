{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0",
        "simulator": false
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "staging-development": {
      "extends": "staging",
      "developmentClient": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "WATCHLY_DEV_CLIENT": "true"
      }
    },
    "preview": {
      "extends": "staging"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "production-internal": {
      "extends": "production",
      "distribution": "internal",
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "testflight": {
      "extends": "production",
      "credentialsSource": "local",
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6808506784",
        "bundleIdentifier": "com.trywatchly.app",
        "ascApiKeyPath": "credentials/ios/AuthKey_87QC3565C9.p8",
        "ascApiKeyIssuerId": "3ace3810-b542-4e3d-989d-cfd639de2491",
        "ascApiKeyId": "87QC3565C9"
      }
    }
  }
}
