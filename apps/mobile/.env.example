# For Expo Go on a physical phone, use your computer LAN IP instead of localhost.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000
# Required in staging and production. This public DSN routes mobile errors to Better Stack.
EXPO_PUBLIC_ERROR_TRACKING_DSN=

# Public Firebase web app config. These values identify the Firebase project but are not backend secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tv-app-9dffd
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional local UI-review auth. Used only in development builds with Firebase Auth Emulator.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
EXPO_PUBLIC_UI_REVIEW_EMAIL=
EXPO_PUBLIC_UI_REVIEW_PASSWORD=

# OAuth client IDs registered for the Firebase/Google project.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public Microsoft Entra application client ID. The mobile flow uses PKCE and no client secret.
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=

# Public Discord application ID. Production builds must use a dedicated Discord application.
EXPO_PUBLIC_DISCORD_APPLICATION_ID=
