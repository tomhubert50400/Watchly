+// Backport of upstream #3449 and #3548, retaining native Liquid Glass.
+static void RNSConstrainHeaderContent(UIView *content, UIView *wrapper)
+{
+  content.translatesAutoresizingMaskIntoConstraints = NO;
+  [wrapper addSubview:content];
+  [content.centerXAnchor constraintEqualToAnchor:wrapper.centerXAnchor].active = YES;
+  [content.centerYAnchor constraintEqualToAnchor:wrapper.centerYAnchor].active = YES;
+  NSLayoutConstraint *width = [wrapper.widthAnchor constraintEqualToAnchor:content.widthAnchor];
+  width.priority = UILayoutPriorityDefaultHigh;
+  width.active = YES;
+  NSLayoutConstraint *height = [wrapper.heightAnchor constraintEqualToAnchor:content.heightAnchor];
+  height.priority = UILayoutPriorityDefaultHigh;
+  height.active = YES;
+}
+
+static UIBarButtonItem *RNSHeaderBarButtonItem(RNSScreenStackHeaderSubview *subview, UIBarButtonItem *previousItem)
+{
+#if !TARGET_OS_TV
+  if (@available(iOS 26.0, *)) {
+    // Keep the native item alive across header updates without a subview/item retain cycle.
+    if (previousItem != nil && subview.superview == previousItem.customView) {
+      return previousItem;
+    }
+    UIView *wrapper = [UIView new];
+    wrapper.translatesAutoresizingMaskIntoConstraints = NO;
+    RNSConstrainHeaderContent(subview, wrapper);
+    [subview setContentHuggingPriority:UILayoutPriorityRequired forAxis:UILayoutConstraintAxisHorizontal];
+    [subview setContentHuggingPriority:UILayoutPriorityRequired forAxis:UILayoutConstraintAxisVertical];
+    [subview setContentCompressionResistancePriority:UILayoutPriorityRequired forAxis:UILayoutConstraintAxisHorizontal];
+    [subview setContentCompressionResistancePriority:UILayoutPriorityRequired forAxis:UILayoutConstraintAxisVertical];
+    return [[UIBarButtonItem alloc] initWithCustomView:wrapper];
+  }
+#endif
+  return [[UIBarButtonItem alloc] initWithCustomView:subview];
+}
+
+#ifdef RCT_NEW_ARCH_ENABLED
+// Preserve the wrapper's dimensions after the live React view is removed during a pop.
+// See upstream issue #4360; the snapshot must replace the content inside the wrapper.
+static void RNSReplaceHeaderContentWithSnapshot(
+    UIBarButtonItem *item, RNSScreenStackHeaderSubview *subview, UIView *snapshot)
+{
+  if (snapshot == nil || item == nil) {
+    return;
+  }
+  if (item.customView == subview) {
+    item.customView = snapshot;
+  } else if (subview.superview != nil && item.customView == subview.superview) {
+    [snapshot.widthAnchor constraintEqualToConstant:subview.bounds.size.width].active = YES;
+    [snapshot.heightAnchor constraintEqualToConstant:subview.bounds.size.height].active = YES;
+    RNSConstrainHeaderContent(snapshot, item.customView);
+  }
+}
+#endif
